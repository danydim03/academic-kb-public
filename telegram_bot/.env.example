# ==============================================================================
# DIMEOGPT Telegram Bot — Environment Variables
# ==============================================================================
# Copia questo file in .env e compila i valori reali.
# NON committare mai il file .env nel repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# Token ottenuto da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=

# Whitelist utenti autorizzati (lista di Telegram user ID, separati da virgola).
# Se vuoto, tutti gli utenti sono ammessi (modalità sviluppo).
# Per scoprire il tuo user ID, scrivi a @userinfobot su Telegram.
TELEGRAM_ALLOWED_USERS=

# ------------------------------------------------------------------------------
# Backend DIMEOGPT
# ------------------------------------------------------------------------------
# URL dell'API FastAPI (usato come fallback se l'import diretto MCP fallisce)
FASTAPI_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Knowledge Graph (necessari se si usa il backend MCP diretto)
# Le stesse variabili usate dal progetto academic-kb principale
# ------------------------------------------------------------------------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIMENSION=768
# EMBEDDING_API_KEY=
